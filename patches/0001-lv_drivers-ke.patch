From 8326182e4e50d33218f45f60a21595312f25a1c3 Mon Sep 17 00:00:00 2001
From: Tim <tim@localhost>
Date: Fri, 29 May 2026 00:01:42 +0200
Subject: [PATCH 1/2] feat: add framebuffer blank and unblank helpers

---
 display/fbdev.c | 10 ++++++++++
 display/fbdev.h |  2 ++
 2 files changed, 12 insertions(+)

diff --git a/display/fbdev.c b/display/fbdev.c
index fe8d2ff..19fe6a4 100644
--- a/display/fbdev.c
+++ b/display/fbdev.c
@@ -268,6 +268,16 @@ void fbdev_set_offset(uint32_t xoffset, uint32_t yoffset) {
     vinfo.yoffset = yoffset;
 }
 
+void fbdev_blank(void) {
+    if(fbfd <= 0) return;
+    ioctl(fbfd, FBIOBLANK, FB_BLANK_POWERDOWN);
+}
+
+void fbdev_unblank(void) {
+    if(fbfd <= 0) return;
+    ioctl(fbfd, FBIOBLANK, FB_BLANK_UNBLANK);
+}
+
 /**********************
  *   STATIC FUNCTIONS
  **********************/
diff --git a/display/fbdev.h b/display/fbdev.h
index b7f2c81..5557513 100644
--- a/display/fbdev.h
+++ b/display/fbdev.h
@@ -50,6 +50,8 @@ void fbdev_get_sizes(uint32_t *width, uint32_t *height, uint32_t *dpi);
  * @param yoffset vertical offset
  */
 void fbdev_set_offset(uint32_t xoffset, uint32_t yoffset);
+void fbdev_blank(void);
+void fbdev_unblank(void);
 
 
 /**********************

From 0406ccb99f8722fcefabadf3660d1d2732d3e89c Mon Sep 17 00:00:00 2001
From: Tim <tim@localhost>
Date: Fri, 29 May 2026 00:08:07 +0200
Subject: [PATCH 2/2] fix(evdev): accept any non-negative ABS_MT_TRACKING_ID as
 press

---
 indev/evdev.c | 6 +++++-
 1 file changed, 5 insertions(+), 1 deletion(-)

diff --git a/indev/evdev.c b/indev/evdev.c
index 4d46b5b..29f29ef 100644
--- a/indev/evdev.c
+++ b/indev/evdev.c
@@ -149,9 +149,13 @@ void evdev_read(lv_indev_drv_t * drv, lv_indev_data_t * data)
                                         evdev_root_y = in.value;
                                 #endif
             else if(in.code == ABS_MT_TRACKING_ID) {
+                                /* Any non-negative tracking id means an active contact.
+                                 * Original code only accepted id 0, which dropped touches
+                                 * on stacks that assign other ids (common on multitouch
+                                 * controllers). -1 still means contact lifted. */
                                 if(in.value == -1)
                                     evdev_button = LV_INDEV_STATE_REL;
-                                else if(in.value == 0)
+                                else
                                     evdev_button = LV_INDEV_STATE_PR;
             }
         } else if(in.type == EV_KEY) {
